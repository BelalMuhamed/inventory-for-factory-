{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "MachineCommunication": {
    "TimeoutSeconds": 100,
    "InfoPort": "33201"
  },
  "Outbox": {
    "Directory": "",
    "ReconciliationIntervalMinutes": 2
  },
  "FileEncryption": {
    "Key": ""
  },
  "ReconciliationCredential": {
    "ClientId": ""
  },
  "InventoryApi": {
    "BaseUrl": "https://localhost:7037/"
  },
  "PrintAgentAuth": {
    "Issuer": "InventoryPlatform",
    "Audience": "InventoryPlatformPrintAgent",
    "SigningKey": ""
  }
}
